<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.aminewsbackend.mapper.ItemMapper">

    <resultMap id="BaseResultMap" type="com.project.aminewsbackend.entity.Item">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="channelId" column="channel_id" jdbcType="INTEGER"/>
            <result property="title" column="title" jdbcType="VARCHAR"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="link" column="link" jdbcType="VARCHAR"/>
            <result property="aiDescription" column="ai_description" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,channel_id,title,
        description,link,ai_description,
        create_time,update_time
    </sql>
</mapper>
